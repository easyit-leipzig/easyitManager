APP_NAME="easyIT Enterprise"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de_DE
APP_URL=http://localhost/easyit-enterprise-RC1.0.4-dev

# Bei true wird storage/framework/cache/config.php verwendet.
CONFIG_CACHE=false

# Standard-Datenbankverbindung
DB_DRIVER=csv
DB_DATABASE=dataform
DB_BASE_PATH=storage/projects

# Enterprise-Datenbanken
# Administrations- und Projektdaten werden bewusst getrennt.
DB_CONNECTION=default
CSV_DATABASE=demo

# Administration
ADMIN_DB_DRIVER=mysql
ADMIN_DB_CSV_BASE_PATH=storage/admin-csv
ADMIN_DB_SQLITE_BASE_PATH=storage/admin-sqlite
ADMIN_DB_HOST=127.0.0.1
ADMIN_DB_PORT=3306
# PostgreSQL: typischer Port 5432; ADMIN_DB_DRIVER=pgsql setzen.
ADMIN_DB_MAINTENANCE_DATABASE=postgres
ADMIN_DB_DATABASE=easyit_license
ADMIN_DB_SCHEMA=public
ADMIN_DB_USERNAME=root
ADMIN_DB_PASSWORD=
ADMIN_DB_CHARSET=utf8mb4

# Standard-Projekt
PROJECT_STORAGE_KEY=
PROJECT_DB_DRIVER=mysql
PROJECT_DB_HOST=127.0.0.1
PROJECT_DB_PORT=3306
# PostgreSQL: typischer Port 5432; PROJECT_DB_DRIVER=pgsql setzen.
PROJECT_DB_MAINTENANCE_DATABASE=postgres
PROJECT_DB_DATABASE=muster_projekt
PROJECT_DB_SCHEMA=public
PROJECT_DB_USERNAME=root
PROJECT_DB_PASSWORD=
PROJECT_DB_CHARSET=utf8mb4
ORACLE_DB_HOST=127.0.0.1
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE=XEPDB1
ORACLE_DB_USERNAME=
ORACLE_DB_PASSWORD=
ORACLE_DB_CHARSET=AL32UTF8

# Logging
LOG_CHANNEL=app
LOG_LEVEL=debug
LOG_MAX_BYTES=5242880
LOG_RETAINED_FILES=5

# Cache Layer
CACHE_STORE=file
CACHE_PATH=storage/framework/cache/data
CACHE_NAMESPACE=dataform5

# Queue Layer
QUEUE_CONNECTION=sync
# Optional bei QUEUE_CONNECTION=database: mysql oder pgsql; leer = ADMIN_DB_DRIVER.
QUEUE_DB_DRIVER=
QUEUE_PATH=storage/framework/queue

# Scheduler
# Optional fuer den Datenbank-Mutex: mysql oder pgsql; leer = ADMIN_DB_DRIVER.
SCHEDULER_DB_DRIVER=
SCHEDULER_LOCK_PATH=storage/framework/scheduler/locks
SCHEDULER_HISTORY_PATH=storage/framework/scheduler/history

# Phase 17 – Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="DataForm5 Core"
APP_FALLBACK_LOCALE=en_US

# Audit
AUDIT_DRIVER=file
AUDIT_FILE=storage/logs/audit.jsonl
AUDIT_KEY=

# Health / diagnostics
HEALTH_ENABLED=true
HEALTH_STORAGE_PATH=storage

# Recovery Layer
RECOVERY_PATH=storage/recovery
RECOVERY_RETAIN=10

# Licensing
LICENSE_MODE=community
LICENSE_ALLOW_COMMUNITY=1
LICENSE_ID=local-community
LICENSE_HOLDER="Local installation"
LICENSE_EDITION=community

# Phase 29: Projektkontext
CONTEXT_AUTO_ACTIVATE=false
CONTEXT_TENANT_ID=
CONTEXT_PROJECT_ID=
CONTEXT_PROJECT_NAME=

# Observability
OBSERVABILITY_DRIVER=file
OBSERVABILITY_FILE=storage/observability/metrics.json
OBSERVABILITY_HEALTH_CHECK=true

# Phase 31 – Rate limiting
RATE_LIMIT_DRIVER=file
RATE_LIMIT_PATH=storage/framework/rate-limit
RATE_LIMIT_PREFIX=df5

# DataForm encryption key for encrypted source passwords
# Wird bei Installation/erster Nutzung automatisch sicher erzeugt.
DATAFORM_APP_KEY=

# Phase 32 – Secrets
SECRETS_DRIVER=file
SECRETS_PATH=storage/framework/secrets/secrets.json
SECRETS_ACTIVE_KEY=main
SECRETS_KEY=change-this-development-key-before-production-0001

# Oracle XE 21c PDB services (used when *_DB_DRIVER=oracle)
ADMIN_DB_ORACLE_SERVICE=XEPDB1
PROJECT_DB_ORACLE_SERVICE=XEPDB1

# Microsoft SQL Server: ADMIN_DB_DRIVER/PROJECT_DB_DRIVER=mssql, PDO_SQLSRV erforderlich
ADMIN_DB_ENCRYPT=1
ADMIN_DB_TRUST_SERVER_CERTIFICATE=0
PROJECT_DB_ENCRYPT=1
PROJECT_DB_TRUST_SERVER_CERTIFICATE=0
